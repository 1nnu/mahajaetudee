#!/bin/bash
set -euo pipefail

DATE=$(date '+%Y-%m-%d')

# Create a dump of the database to the bind mount
docker exec database pg_dumpall -c -U {{ database_user }} > /backups/dump.sql

# Launch an aws-cli container to send to backup to S3
docker run --rm \
    -v /root/.aws:/root/.aws \
    -v /backups/postgres:/root/backups \
    amazon/aws-cli \
    s3 cp /root/backups/dump.sql "{{ aws_s3_bucket_uri }}/${DATE}.sql"
